MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/
MONGODB_DATABASE=nombre_base_datos

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
# Misma clave privada configurada en SFJPII-back. No usar en el frontend.
SFJPII_AI_SERVICE_KEY=
# Días que se conserva un chat desde su última actividad. Usa 0 para no aplicar vencimiento a chats nuevos.
CHAT_RETENTION_DAYS=180
# Documento editable que consulta el asistente para teléfonos, dirección y horarios.
# Puede ser una ruta relativa a SFJPII-AI o una ruta absoluta en el servidor.
PHARMACY_INFO_DOCX=data/informacion_farmacia.docx
# URL pública del backend que FastAPI verificará cada 13 minutos en Render.
SFJPII_BACKEND_URL=...
# 780 segundos = 13 minutos. En Render se activa automáticamente.
KEEP_ALIVE_INTERVAL_SECONDS=780
# Opcional fuera de Render: true para activar o false para desactivar.
KEEP_ALIVE_ENABLED=false
