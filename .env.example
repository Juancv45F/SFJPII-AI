MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/
MONGODB_DATABASE=nombre_base_datos

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
# Misma clave privada configurada en SFJPII-back. No usar en el frontend.
SFJPII_AI_SERVICE_KEY=
# Días que se conserva un chat desde su última actividad. Usa 0 para no aplicar vencimiento a chats nuevos.
CHAT_RETENTION_DAYS=180
