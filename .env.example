MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/
MONGODB_DATABASE=nombre_base_datos

# Proveedor de IA: deepseek, qwen u openai. Solo es obligatoria la clave del proveedor elegido.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
# Opcionales. Vacíos usan el modelo y la URL por defecto del proveedor.
# Al cambiar AI_PROVIDER, vacía o actualiza también estos dos valores.
# En OpenAI el valor por defecto es gpt-6-luna. Con Chat Completions y tools
# también sirve gpt-6-sol; gpt-6-astra, gpt-6.1-sol y gpt-6.1-terra no.
AI_MODEL=
AI_BASE_URL=
# Solo OpenAI. Vacío envía "none", obligatorio con tools desde GPT-5.4.
# Usa off para no enviarlo con modelos que no acepten el parámetro.
AI_REASONING_EFFORT=
# Límite en segundos por llamada al modelo y por turno completo con sus tools.
# El turno debe terminar antes del maxDuration de vercel.json (300 s).
AI_REQUEST_TIMEOUT_SECONDS=45
AI_TURN_TIMEOUT_SECONDS=225
# Tope de tokens generados por cada llamada al modelo. Acota el gasto por turno.
AI_MAX_OUTPUT_TOKENS=2048
# Misma clave privada configurada en SFJPII-back. No usar en el frontend.
SFJPII_AI_SERVICE_KEY=
# Días que se conserva un chat desde su última actividad. Usa 0 para no aplicar vencimiento a chats nuevos.
CHAT_RETENTION_DAYS=180
# Documento editable que consulta el asistente para teléfonos, dirección y horarios.
# Puede ser una ruta relativa a SFJPII-AI o una ruta absoluta en el servidor.
# En Vercel usa la ruta relativa: el documento viaja en el deploy y es de solo lectura.
PHARMACY_INFO_DOCX=data/informacion_farmacia.docx
